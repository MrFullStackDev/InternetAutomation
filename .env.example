# Copy to .env and edit as needed. Every value here is optional.

# --- Site under test ---
# BASE_URL=https://the-internet.herokuapp.com

# --- Credentials used by basic-auth + secure-download tests ---
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASS=admin

# --- Credentials used by form-auth tests ---
# FORM_AUTH_USER=tomsmith
# FORM_AUTH_PASS=SuperSecretPassword!

# --- Dashboard ---
# DASHBOARD_PORT=4000
# DASHBOARD_DB_PATH=dashboard/data/results.db

# --- CI metadata recorded with each run (optional) ---
# GIT_BRANCH=main
# GIT_COMMIT=$(git rev-parse HEAD)
